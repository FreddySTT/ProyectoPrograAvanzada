# ==============================================================================
# RIQSI RUTAS — Docker Environment Configuration
# ==============================================================================
# Renombrar este archivo a `.env` antes de ejecutar `docker compose up --build`
#
# Flujo de Datos:
# Supabase Cloud Database <---> Backend Flask (5000) <---> Frontend React SPA (80 / 3000)
# ==============================================================================

# Credenciales de Supabase Cloud
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY

# Configuración del Backend
FLASK_ENV=production
PORT=5000

# Base path del Frontend en Docker (por defecto /)
VITE_BASE_PATH=/
