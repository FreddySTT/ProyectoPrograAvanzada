# ==============================================================================
# RIQSI RUTAS — Docker Environment Configuration
# ==============================================================================
# Renombrar este archivo a `.env.docker` antes de ejecutar:
#   docker compose --env-file .env.docker up --build -d
#
# Flujo de Datos:
# Supabase Cloud Database <---> Backend Flask (5050) <---> Frontend React SPA (80 / 3000)
# ==============================================================================

# ── Credenciales de Supabase Cloud ──────────────────────────────────────────────
SUPABASE_URL=https://mgkxnplbcdxfuxdlcyzl.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY

# ── Configuración del Backend Flask ───────────────────────────────────────────
FLASK_ENV=production
PORT=5000

# ── Base path del Frontend en Docker (por defecto /) ──────────────────────────
VITE_BASE_PATH=/

# ── Switch de Backend ─────────────────────────────────────────────────────────
# Opciones: "supabase" (default) | "firebase"
VITE_BACKEND=supabase

# ── Firebase (completar solo si VITE_BACKEND=firebase) ────────────────────────
# Encontrar en: https://console.firebase.google.com → Configuración del proyecto → Tus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=riqsi-rutas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=riqsi-rutas
VITE_FIREBASE_STORAGE_BUCKET=riqsi-rutas.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
