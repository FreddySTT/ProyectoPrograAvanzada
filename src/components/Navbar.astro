---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<header class="navbar-header">
  <div class="navbar-inner">
    <!-- LOGO / BRAND -->
    <a href={`${baseUrl}/`} class="brand-link">
      <div class="brand-icon">
        <span>⚔</span>
      </div>
      <div class="brand-info">
        <span class="brand-title cinzel">RIQSI RUTAS</span>
        <span class="brand-sub mono">
          <span class="live-dot"></span> RUTAS & TURISMO // VOL. 2026
        </span>
      </div>
    </a>

    <!-- LINKS DE NAVEGACIÓN -->
    <nav class="nav-menu">
      <a href={`${baseUrl}/`} class={currentPath === baseUrl || currentPath === "" ? "nav-link active" : "nav-link"}>
        <span>🔥 Inicio</span>
      </a>
      <a href={`${baseUrl}/materias`} class={currentPath.includes("/materias") ? "nav-link active" : "nav-link"}>
        <span>📜 Materias</span>
        <span class="mini-badge mono">UNI</span>
      </a>
      <a href={`${baseUrl}/personales`} class={currentPath.includes("/personales") ? "nav-link active" : "nav-link"}>
        <span>⚔️ Personales</span>
        <span class="mini-badge mono">LAB</span>
      </a>
    </nav>

    <!-- CONTACTO -->
    <div class="nav-action-wrap">
      <a href="#contacto" class="nav-btn-contact mono">
        <span>Contactar</span> ✉️
      </a>
    </div>
  </div>
</header>
