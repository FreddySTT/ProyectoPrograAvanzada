---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<header class="navbar-header">
  <div class="navbar-inner">
    <a href={`${baseUrl}/`} class="brand-link">
      <div class="brand-icon">
        <span>🧭</span>
      </div>
      <div class="brand-info">
        <span class="brand-title cinzel">RIQSI RUTAS</span>
        <span class="brand-sub mono">
          <span class="live-dot"></span> TURISMO & OPTIMIZACIÓN INTELIGENTE
        </span>
      </div>
    </a>

    <nav class="nav-menu">
      <a href={`${baseUrl}/`} class={currentPath === baseUrl || currentPath === "" ? "nav-link active" : "nav-link"}>
        <span>🏠 Inicio</span>
      </a>
      <a href={`${baseUrl}/rutas`} class={currentPath.includes("/rutas") ? "nav-link active" : "nav-link"}>
        <span>🗺️ Rutas & Destinos</span>
      </a>
      <a href={`${baseUrl}/especificaciones`} class={currentPath.includes("/especificaciones") ? "nav-link active" : "nav-link"}>
        <span>⚙️ Spec Kit AI</span>
      </a>
    </nav>

    <div class="nav-action-wrap">
      <a href="#buscador" class="nav-btn-contact mono">
        <span>Planificar Ruta</span> ➔
      </a>
    </div>
  </div>
</header>
