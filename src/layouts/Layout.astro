---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Freddy Sergio Tejerina - Desarrollador de Software. Portafolio de Materias & Proyectos Personales." 
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/style.css`} />
    <title>{title} | Riqsi Rutas ✦ Sistema Inteligente</title>
  </head>
  <body>
    <!-- Glow de fondo temático Negro & Rojo Carmesí -->
    <div class="ambient-glow glow-top"></div>
    <div class="ambient-glow glow-left"></div>
    <div class="ambient-glow glow-right"></div>

    <Navbar />
    
    <main class="main-wrapper">
      <slot />
    </main>

    <Footer />

    <!-- MODAL LIGHTBOX DE ZOOM A IMÁGENES / CÓDIGO -->
    <div class="image-zoom-modal" id="zoomModal">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-content">
        <button class="modal-close-btn" id="closeModalBtn" title="Cerrar (ESC)">✕</button>
        <div class="modal-image-wrapper">
          <div id="modalMockupContent" class="modal-mockup-slot"></div>
        </div>
        <div class="modal-caption" id="modalCaption">
          <span class="modal-caption-title cinzel">Vista Detallada del Proyecto</span>
          <span class="modal-caption-sub mono">PRESIONÁ [ESC] O CLIC FUERA PARA CERRAR</span>
        </div>
      </div>
    </div>

    <!-- TOASTS -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- SCRIPTS INTERACTIVOS GLOBALES -->
    <script>
      // 1. MODAL ZOOM
      const zoomModal = document.getElementById('zoomModal');
      const modalBackdrop = document.getElementById('modalBackdrop');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const modalMockupContent = document.getElementById('modalMockupContent');
      const modalCaption = document.getElementById('modalCaption');

      function openZoom(contentHtml, titleText) {
        if (zoomModal && modalMockupContent) {
          modalMockupContent.innerHTML = contentHtml;
          if (modalCaption && titleText) {
            const titleEl = modalCaption.querySelector('.modal-caption-title');
            if (titleEl) titleEl.textContent = titleText;
          }
          zoomModal.classList.add('active');
          document.body.style.overflow = 'hidden';
          playBeep(600, 0.05);
        }
      }

      function closeZoom() {
        if (zoomModal) {
          zoomModal.classList.remove('active');
          document.body.style.overflow = '';
          playBeep(400, 0.05);
        }
      }

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeZoom);
      if (modalBackdrop) modalBackdrop.addEventListener('click', closeZoom);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeZoom();
      });

      document.addEventListener('click', (e) => {
        const target = e.target.closest('[data-zoom-trigger]');
        if (target) {
          const card = target.closest('.project-box');
          if (card) {
            const previewBox = card.querySelector('.project-preview-mockup');
            const title = card.querySelector('.box-title')?.textContent || 'Proyecto';
            if (previewBox) {
              openZoom(previewBox.innerHTML, title);
            }
          }
        }
      });

      // 2. AUDIO WEB API SINTETIZADO
      let audioCtx = null;
      function getAudioContext() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        return audioCtx;
      }

      function playBeep(freq = 550, duration = 0.06, type = 'sine') {
        try {
          const ctx = getAudioContext();
          if (ctx.state === 'suspended') ctx.resume();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = type;
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + duration);
        } catch (err) {}
      }

      document.addEventListener('click', (e) => {
        const el = e.target.closest('button, .card-btn, .btn-hero, .nav-link, .nav-btn-contact');
        if (el) playBeep(750, 0.04, 'triangle');
      });

      // 3. TOASTS
      window.showToast = function(msg) {
        const container = document.getElementById('toastContainer');
        if (container) {
          const toast = document.createElement('div');
          toast.className = 'cyber-toast mono';
          toast.innerHTML = '<span>✦</span> ' + msg;
          container.appendChild(toast);
          playBeep(900, 0.08, 'sine');
          setTimeout(() => {
            toast.classList.add('fade-out');
            setTimeout(() => toast.remove(), 300);
          }, 3000);
        }
      };
    </script>
  </body>
</html>

<style>
  .image-zoom-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .image-zoom-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 2, 3, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-content {
    position: relative;
    z-index: 2;
    background: #140d10;
    border: 2px solid var(--border-red-bright);
    border-radius: 12px;
    max-width: 860px;
    width: 100%;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 35px rgba(220, 38, 38, 0.4);
    overflow: hidden;
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-red);
    color: var(--red-bright);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .modal-close-btn:hover {
    background: #ef4444;
    color: white;
    transform: rotate(90deg);
  }

  .modal-image-wrapper {
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #080506;
  }

  .modal-mockup-slot {
    width: 100%;
  }

  .modal-caption {
    padding: 1.2rem 1.8rem;
    background: #170d10;
    border-top: 1px solid var(--border-red);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .modal-caption-title {
    font-size: 1.15rem;
    color: var(--red-bright);
    font-weight: 800;
  }

  .modal-caption-sub {
    font-size: 0.72rem;
    color: var(--text-dark);
  }

  .toast-container {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    pointer-events: none;
  }

  .cyber-toast {
    background: #1c0f14;
    border: 1px solid var(--red-bright);
    color: var(--text-white);
    padding: 0.75rem 1.2rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px rgba(220, 38, 38, 0.35);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cyber-toast span {
    color: var(--red-bright);
  }

  .cyber-toast.fade-out {
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }
</style>
