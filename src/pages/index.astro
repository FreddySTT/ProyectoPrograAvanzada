---
import Layout from '../layouts/Layout.astro';

const stats = [
  { valor: "24/7", label: "Optimización", sub: "Algoritmos en tiempo real" },
  { valor: "+18", label: "Rutas Turísticas", sub: "Circuitos urbanos y naturales" },
  { valor: "O(E log V)", label: "Eficiencia", sub: "Algoritmo de Dijkstra" },
  { valor: "100%", label: "Precisión", sub: "Integración meteorológica" }
];

const rutasDestacadas = [
  {
    titulo: "Ruta Histórica & Arquitectónica",
    tipo: "TURISMO PATRIMONIAL",
    tiempo: "45 min // 4.2 km",
    descripcion: "Circuito por los principales monumentos, museos y centros culturales con paradas optimizadas según flujo peatonal.",
    metrica: "Ruta más corta calculada con Dijkstra",
    tags: ["Centro Histórico", "Cultura", "Peatonal", "Grafos"]
  },
  {
    titulo: "Circuito Ecoturístico & Paisajístico",
    tipo: "NATURALEZA & AVENTURA",
    tiempo: "1h 20 min // 12.8 km",
    descripcion: "Trayecto de conexión entre miradores urbanos y senderos naturales con integración de datos del clima en vivo.",
    metrica: "Filtrado automático por condición meteorológica",
    tags: ["Miradores", "Sendero", "Clima Real-Time", "OpenWeather"]
  },
  {
    titulo: "Ruta de Conexión Express Urbana",
    tipo: "TRANSPORTE INTELIGENTE",
    tiempo: "25 min // 8.5 km",
    descripcion: "Navegación ágil entre terminales principales y nodos turísticos con mínima interferencia de tráfico congestionado.",
    metrica: "Grafo dinámico de pesos variables",
    tags: ["Transporte", "Nodos", "Movilidad Rápidas"]
  }
];
---

<Layout title="Inicio">
  <!-- HERO PRINCIPAL -->
  <section class="hero-box">
    <div class="hero-status-pill mono">
      <span class="status-dot-red"></span>
      <span>PLATAFORMA DE RUTAS TURÍSTICAS & NAVEGACIÓN INTELIGENTE</span>
    </div>

    <h1 class="hero-title-big cinzel">
      RIQSI<br/>
      <span class="red-gradient-text">RUTAS</span>
    </h1>

    <div class="typewriter-box mono">
      <span class="type-prompt">&gt;</span>
      <span id="typewriterTarget">Explora y optimiza tu camino inteligente</span>
      <span class="type-cursor">|</span>
    </div>

    <p class="hero-intro-text">
      <strong>Riqsi Rutas</strong> es la plataforma interactiva diseñada para la planificación, cálculo y optimización de trayectos turísticos y movilidad urbana. Mediante algoritmos de grafos avanzados, calculamos la ruta óptima para que aproveches al máximo tu experiencia.
    </p>

    <div class="hero-actions-row">
      <a href={`${import.meta.env.BASE_URL}/rutas`} class="btn-hero primary">
        <span>🗺️ Explorar Rutas</span>
        <span>➔</span>
      </a>
      <a href="#buscador" class="btn-hero secondary">
        <span>🔍 Simular Trayecto</span>
      </a>
    </div>

    <div class="stats-container">
      {stats.map(s => (
        <div class="stat-item">
          <span class="stat-number cinzel">{s.valor}</span>
          <strong class="stat-label">{s.label}</strong>
          <span class="stat-meta mono">{s.sub}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- WIDGET SIMULADOR DE BÚSQUEDA DE RUTAS -->
  <section class="route-search-widget" id="buscador">
    <h3 class="cinzel widget-title">
      <span>🧭</span>
      <span>Planificador Inteligente de Trayectos</span>
    </h3>
    <div class="widget-grid">
      <div class="input-group">
        <label class="mono">PUNTO DE ORIGEN (NODO A)</label>
        <select id="originSelect" class="route-select">
          <option value="1">Plaza Principal (Nodo 1)</option>
          <option value="2">Terminal de Buses (Nodo 2)</option>
          <option value="3">Mirador del Valle (Nodo 3)</option>
        </select>
      </div>

      <div class="input-group">
        <label class="mono">DESTINO DESEADO (NODO B)</label>
        <select id="destSelect" class="route-select">
          <option value="3">Mirador del Valle (Nodo 3)</option>
          <option value="4">Centro Gastronómico (Nodo 4)</option>
          <option value="5">Parque Nacional (Nodo 5)</option>
        </select>
      </div>

      <div class="input-group">
        <label class="mono">PREFERENCIA</label>
        <select class="route-select">
          <option>Ruta Más Rápida (Dijkstra)</option>
          <option>Ruta Escénica / Turística</option>
          <option>Ruta Ecoturística</option>
        </select>
      </div>

      <button class="btn-find-route mono" onclick="simularRuta();">
        Calcular Ruta ➔
      </button>
    </div>

    <div id="resultBox" style="display:none; margin-top:1.5rem; background:#080506; border:1px solid var(--border-red); padding:1.2rem; border-radius:8px; font-family:'JetBrains Mono', monospace; font-size:0.88rem; color:#4ade80;">
    </div>
  </section>

  <!-- MOSTRAR RUTAS DESTACADAS -->
  <section>
    <div style="margin-bottom: 2rem;">
      <span class="mono" style="color: var(--red-bright); font-size: 0.75rem; letter-spacing: 1.5px;">// CIRCUITOS POPULARES</span>
      <h2 class="cinzel" style="font-size: 2rem; color: var(--text-white);">Rutas Recomendadas</h2>
    </div>

    <div class="cards-layout-grid">
      {rutasDestacadas.map(r => (
        <div class="route-card">
          <div>
            <div class="card-top">
              <span class="category-badge">{r.tipo}</span>
              <span class="time-pill mono">{r.tiempo}</span>
            </div>
            <h3 class="card-title cinzel">{r.titulo}</h3>
            <p class="card-desc">{r.descripcion}</p>
            <div class="metric-box mono">★ {r.metrica}</div>
          </div>

          <div>
            <div class="tags-list mono">
              {r.tags.map(t => (
                <span class="tag-item">{t}</span>
              ))}
            </div>
            <a href={`${import.meta.env.BASE_URL}/rutas`} class="btn-detail mono">
              <span>Ver Mapa y Nodos</span> ➔
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  // TYPEWRITER
  const phrases = [
    "Descubre y optimiza tus trayectos turísticos",
    "Algoritmo de Dijkstra para la ruta más eficiente",
    "Integración en tiempo real con clima y sensores",
    "Desarrollado con GitHub Spec Kit + Gemini AI"
  ];
  let phraseIdx = 0; let charIdx = 0; let isDeleting = false;
  const target = document.getElementById('typewriterTarget');
  function typeStep() {
    if (!target) return;
    const current = phrases[phraseIdx];
    if (isDeleting) { target.textContent = current.substring(0, charIdx - 1); charIdx--; }
    else { target.textContent = current.substring(0, charIdx + 1); charIdx++; }
    let speed = isDeleting ? 30 : 60;
    if (!isDeleting && charIdx === current.length) { speed = 2200; isDeleting = true; }
    else if (isDeleting && charIdx === 0) { isDeleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; speed = 400; }
    setTimeout(typeStep, speed);
  }
  typeStep();

  // SIMULADOR DE RUTA
  (window as any).simularRuta = function() {
    const box = document.getElementById('resultBox');
    if (box) {
      box.style.display = 'block';
      box.innerHTML = '⚡ [EJECUTANDO DIJKSTRA]: Calculando matriz de pesos...\n✦ Ruta Óptima: Nodo 1 ➔ Nodo 4 ➔ Nodo 3\n⏱ Distancia: 4.5 km | Tiempo Estimado: 14 minutos\n☀️ Clima en Destino: 22°C // Despejado (Óptimo para visitar)';
    }
  };
</script>
