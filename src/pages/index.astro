---
import Layout from '../layouts/Layout.astro';

const stats = [
  { valor: "⭐ 4.9/5", label: "Satisfacción", sub: "+1,200 viajeros conectados" },
  { valor: "24/7", label: "Monitoreo", sub: "Algoritmo de Dijkstra en vivo" },
  { valor: "+24", label: "Destinos Top", sub: "Circuitos urbanos y culturales" },
  { valor: "100%", label: "Precisión", sub: "Integración meteorológica" }
];

const rutasRecomendadas = [
  {
    titulo: "Circuito Histórico & Colonial",
    tipo: "🏛️ PATRIMONIO & CULTURA",
    rating: "⭐ 4.9 (340 opiniones)",
    tiempo: "45 min // 4.2 km",
    descripcion: "Recorrido por los museos emblemáticos, iglesias coloniales y plazas centrales. Ideal para caminar y tomar fotos.",
    metrica: "Trayecto óptimo calculado con Dijkstra",
    tags: ["Centro Histórico", "Cultura", "Peatonal", "Fotos"]
  },
  {
    titulo: "Ruta Ecoturística & Miradores",
    tipo: "🌲 NATURALEZA & AVENTURA",
    rating: "⭐ 4.8 (210 opiniones)",
    tiempo: "1h 15 min // 11.5 km",
    descripcion: "Conecta los senderos naturales más vistosos con los mejores puntos panorámicos de la ciudad.",
    metrica: "Filtro automático según condición del clima",
    tags: ["Miradores", "Sendero", "Clima Real-Time", "Aire Puro"]
  },
  {
    titulo: "Circuito Gastronómico Tradicional",
    tipo: "🍕 GASTRONOMÍA & SABORES",
    rating: "⭐ 5.0 (480 opiniones)",
    tiempo: "50 min // 5.1 km",
    descripcion: "Visita los mejores puntos culinarios, mercados tradicionales y cafeterías típicas de la ciudad.",
    metrica: "Ruta optimizada con menor tiempo de espera",
    tags: ["Comida Típica", "Mercados", "Degustación"]
  }
];
---

<Layout title="Buscador de Rutas & Turismo">
  <!-- HERO ESTILO BOOKING -->
  <section class="hero-box">
    <div class="hero-status-pill mono">
      <span class="status-dot-blue"></span>
      <span>PLATAFORMA AMIGABLE DE NAVEGACIÓN & TURISMO INTELIGENTE</span>
    </div>

    <h1 class="hero-title-big cinzel">
      Encuentra la Ruta Perfecta<br/>
      <span class="yellow-gradient-text">para tu Próximo Viaje</span>
    </h1>

    <div class="typewriter-box mono">
      <span class="type-prompt">&gt;</span>
      <span id="typewriterTarget">Planifica tu recorrido de forma fácil y rápida</span>
      <span class="type-cursor">|</span>
    </div>

    <p class="hero-intro-text">
      En <strong>Riqsi Rutas</strong> te ayudamos a descubrir los mejores caminos. Ya sea que busques un recorrido turístico relajante o la ruta más rápida de transporte, nuestro motor de inteligencia artificial calcula el trayecto ideal para ti.
    </p>

    <div class="hero-actions-row">
      <a href="#buscador" class="btn-hero primary">
        <span>🔍 Buscar una Ruta Ahora</span>
      </a>
      <a href={`${import.meta.env.BASE_URL}/rutas`} class="btn-hero secondary">
        <span>🗺️ Ver Todos los Destinos</span>
      </a>

    </div>

    <div class="stats-container">
      {stats.map(s => (
        <div class="stat-item">
          <span class="stat-number cinzel">{s.valor}</span>
          <strong class="stat-label">{s.label}</strong>
          <span class="stat-meta mono">{s.sub}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- WIDGET BUSCADOR ESTILO BOOKING.COM -->
  <section class="booking-search-card" id="buscador">
    <div class="search-card-inner">
      <h3 class="widget-title cinzel">
        <span>🔎</span>
        <span>¿A dónde quieres ir hoy?</span>
      </h3>

      <div class="widget-grid">
        <div class="input-group">
          <label class="mono">📍 PUNTO DE ORIGEN</label>
          <select id="originSelect" class="route-select">
            <option value="1">🏛️ Plaza Principal (Nodo 1)</option>
            <option value="2">🚌 Terminal de Autobuses (Nodo 2)</option>
            <option value="3">⛰️ Mirador del Valle (Nodo 3)</option>
          </select>
        </div>

        <div class="input-group">
          <label class="mono">🏁 DESTINO FINAL</label>
          <select id="destSelect" class="route-select">
            <option value="3">⛰️ Mirador del Valle (Nodo 3)</option>
            <option value="4">🍲 Centro Gastronómico (Nodo 4)</option>
            <option value="5">🌲 Parque Nacional (Nodo 5)</option>
          </select>
        </div>

        <div class="input-group">
          <label class="mono">🎒 TIPO DE VIAJE</label>
          <select class="route-select">
            <option>⚡ Ruta Más Rápida (Dijkstra)</option>
            <option>📸 Ruta Turística & Fotos</option>
            <option>🍃 Ruta Ecoturística</option>
          </select>
        </div>

        <button class="btn-find-route mono" onclick="simularRuta();">
          BUSCAR RUTA ➔
        </button>
      </div>

      <div id="resultBox" style="display:none; margin-top:1.5rem; background:#0a1128; border:2px solid var(--booking-yellow); padding:1.4rem; border-radius:10px; font-family:'Outfit', sans-serif; font-size:0.95rem; color:#ffffff;">
      </div>
    </div>
  </section>

  <!-- SECCIÓN CIRCUITOS POPULARES ESTILO TRIPADVISOR / BOOKING -->
  <section>
    <div style="margin-bottom: 2rem;">
      <span class="mono" style="color: var(--booking-yellow); font-size: 0.8rem; font-weight: 800; letter-spacing: 1px;">// EXPERIENCIAS RECOMENDADAS</span>
      <h2 class="cinzel" style="font-size: 2.2rem; color: var(--text-white);">Destinos y Circuitos Más Populares</h2>
    </div>

    <div class="cards-layout-grid">
      {rutasRecomendadas.map(r => (
        <div class="travel-card">
          <div>
            <div class="card-badge-row">
              <span class="rating-badge gold">{r.tipo}</span>
              <span class="time-pill mono">⏱ {r.tiempo}</span>
            </div>

            <h3 class="card-title cinzel">{r.titulo}</h3>
            <span style="font-size: 0.8rem; color: var(--booking-yellow); font-weight: 700; display: block; margin-bottom: 0.8rem;">{r.rating}</span>

            <p class="card-desc">{r.descripcion}</p>
            <div class="price-metric-box mono">★ {r.metrica}</div>
          </div>

          <div>
            <div class="tags-list mono">
              {r.tags.map(t => (
                <span class="tag-item">{t}</span>
              ))}
            </div>
            <a href={`${import.meta.env.BASE_URL}/rutas`} class="btn-detail mono">
              <span>Ver Detalle del Recorrido</span> ➔
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  // TYPEWRITER AMIGABLE
  const phrases = [
    "Encuentra la mejor ruta para tu próximo viaje",
    "Calcula trayectos rápidos y seguros en segundos",
    "Circuito de turismo, naturaleza y gastronomía",
    "Desarrollado con GitHub Spec Kit + Gemini AI"
  ];
  let phraseIdx = 0; let charIdx = 0; let isDeleting = false;
  const target = document.getElementById('typewriterTarget');
  function typeStep() {
    if (!target) return;
    const current = phrases[phraseIdx];
    if (isDeleting) { target.textContent = current.substring(0, charIdx - 1); charIdx--; }
    else { target.textContent = current.substring(0, charIdx + 1); charIdx++; }
    let speed = isDeleting ? 30 : 60;
    if (!isDeleting && charIdx === current.length) { speed = 2200; isDeleting = true; }
    else if (isDeleting && charIdx === 0) { isDeleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; speed = 400; }
    setTimeout(typeStep, speed);
  }
  typeStep();

  // SIMULADOR DE BÚSQUEDA TIPO BOOKING
  (window as any).simularRuta = function() {
    const box = document.getElementById('resultBox');
    if (box) {
      box.style.display = 'block';
      box.innerHTML = '🎉 <strong>¡Ruta Encontrada con Éxito!</strong><br/><br/>' +
        '📍 <strong>Trayecto:</strong> Nodo Origen ➔ Centro Histórico ➔ Destino Seleccionado<br/>' +
        '⏱ <strong>Tiempo Estimado:</strong> 14 minutos (Ruta recomendada sin tráfico)<br/>' +
        '☀️ <strong>Clima en la Zona:</strong> 22°C // Despejado y óptimo para pasear<br/>' +
        '⭐ <strong>Puntuación de Viajeros:</strong> 4.9/5';
    }
  };
</script>
