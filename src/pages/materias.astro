---
import Layout from '../layouts/Layout.astro';
import CardProyecto from '../components/CardProyecto.astro';

const proyectosMaterias = [
  {
    titulo: "Sistema de Control de Alumnos & Correlatividades",
    materiaOEstado: "Algoritmos II (Nota: 10/10)",
    profesorOCatedra: "Cátedra de Estructuras de Datos Avanzadas",
    fecha: "2025 - 2º Cuatrimestre",
    descripcion: "Aplicación de consola en C++ para gestionar inscripciones, notas y validación en tiempo real del árbol de materias correlativas con árboles binarios ABB.",
    metrica: "Búsqueda indexada en O(log N) // Serialización binaria",
    mockupTag: "C++ // ABB CORRELATIVAS",
    previewCode: "// Control de árbol de correlativas en C++\nstruct NodoMateria {\n  string codigo;\n  vector<string> correlativas;\n  NodoMateria* izq;\n  NodoMateria* der;\n};",
    tags: ["C++", "Árboles Binarios (ABB)", "Punteros", "Algoritmos", "CLI"],
    categoriaData: "algoritmos",
    caracteristicas: [
      "Persistencia de registros en archivos binarios (.dat)",
      "Validación de árbol de correlatividades sin recursión infinita",
      "Control de memoria dinámica sin memory leaks"
    ],
    linkRepo: "https://github.com/tu-usuario/proyecto-algoritmos"
  },
  {
    titulo: "Arquitectura & Optimización de Base de Datos Hospitalaria",
    materiaOEstado: "Bases de Datos I (Nota: 9/10)",
    profesorOCatedra: "Cátedra de Ingeniería de Datos",
    fecha: "2025 - 1º Cuatrimestre",
    descripcion: "Diseño completo relacional: Diagrama Entidad-Relación (DER), normalización en 3FN, transacciones ACID, triggers de seguridad y vistas indexadas.",
    metrica: "Cero anomalías en 3FN // 15+ Procedimientos",
    mockupTag: "SQL // POSTGRESQL TRIGGERS",
    previewCode: "-- Trigger de verificación de quirófanos\nCREATE OR REPLACE FUNCTION check_quirofano()\nRETURNS TRIGGER AS $$\nBEGIN\n  IF EXISTS (SELECT 1 FROM turnos WHERE quirofano_id = NEW.quirofano_id) THEN\n    RAISE EXCEPTION 'Quirófano ocupado en este horario';\n  END IF;\n  RETURN NEW;\nEND; $$ LANGUAGE plpgsql;",
    tags: ["PostgreSQL", "PL/pgSQL", "Triggers", "Normalización", "SQL"],
    categoriaData: "bases-de-datos",
    caracteristicas: [
      "Trigger automático para impedir superposición de turnos de quirófano",
      "Vistas materializadas para reportes estadísticos de guardia",
      "Garantía de integridad referencial bajo concurrencia"
    ],
    linkRepo: "https://github.com/tu-usuario/bd-hospital"
  },
  {
    titulo: "Simulador de Planificación de Procesos en SO",
    materiaOEstado: "Sistemas Operativos (Nota: 10/10)",
    profesorOCatedra: "Cátedra de Arquitectura & Sistemas",
    fecha: "2024 - 2º Cuatrimestre",
    descripcion: "Simulador interactivo de algoritmos de scheduling del kernel: Round Robin con Quantum adaptativo, Shortest Job First (SJF) y Prioridades con Envejecimiento.",
    metrica: "Cálculo en tiempo real de Turnaround y Waiting Time",
    mockupTag: "PYTHON // CPU SCHEDULING",
    previewCode: "# Round Robin Scheduling Algorithm\nwhile queue:\n  proc = queue.pop(0)\n  exec_time = min(quantum, proc.remaining_time)\n  current_time += exec_time\n  proc.remaining_time -= exec_time",
    tags: ["Python", "Concurrencia", "Hilos / Threads", "Scheduling", "SO"],
    categoriaData: "sistemas",
    caracteristicas: [
      "Simulación de ráfagas de CPU y operaciones de I/O bloqueantes",
      "Prevención algorítmica de estados de inanición (starvation)"
    ],
    linkRepo: "https://github.com/tu-usuario/simulador-cpu"
  },
  {
    titulo: "Servidor de Mensajería Concurrente TCP con Sockets",
    materiaOEstado: "Redes y Telecomunicaciones (Nota: Distinción)",
    profesorOCatedra: "Cátedra de Redes & Protocolos",
    fecha: "2024 - 1º Cuatrimestre",
    descripcion: "Implementación en lenguaje C de un servidor multi-hilo para mensajería en red local con arquitectura cliente-servidor y manejo de protocolos TCP/IP.",
    metrica: "Manejo de múltiples clientes vía pthreads",
    mockupTag: "C // POSIX SOCKETS",
    previewCode: "// Socket creation and binding in C\nint server_fd = socket(AF_INET, SOCK_STREAM, 0);\nbind(server_fd, (struct sockaddr*)&address, sizeof(address));\nlisten(server_fd, 10);",
    tags: ["C", "Sockets TCP/IP", "Multithreading", "Redes", "POSIX"],
    categoriaData: "sistemas",
    caracteristicas: [
      "Salas grupales y mensajes privados punto a punto",
      "Manejo de señales del sistema para cierre ordenado"
    ],
    linkRepo: "https://github.com/tu-usuario/chat-sockets-tcp"
  }
];
---

<Layout title="Proyectos de Materias">
  <div class="section-head" style="margin-bottom: 2.5rem;">
    <a href="/" class="mono" style="color: var(--red-bright); display: inline-block; margin-bottom: 1rem;">← VOLVER AL INICIO</a>
    <span class="section-tag mono">GRIMORIO ACADÉMICO // UNIVERSIDAD</span>
    <h1 class="cinzel" style="font-size: clamp(2rem, 4.5vw, 3.2rem); color: var(--text-white); margin-bottom: 0.8rem;">Proyectos de Materias & Cátedras</h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 800px;">
      Archivo técnico de investigaciones, algoritmos y proyectos prácticos evaluados por cátedras universitarias.
    </p>
  </div>

  <!-- FILTROS TABS -->
  <div class="tabs-filter-bar">
    <button class="filter-tab-btn active" data-filter="todos">
      <span>⚡ Todos</span>
      <span class="mini-badge mono">[4]</span>
    </button>
    <button class="filter-tab-btn" data-filter="algoritmos">
      <span>⚔️ Algoritmos & C++</span>
      <span class="mini-badge mono">[1]</span>
    </button>
    <button class="filter-tab-btn" data-filter="bases-de-datos">
      <span>🛡️ Bases de Datos & SQL</span>
      <span class="mini-badge mono">[1]</span>
    </button>
    <button class="filter-tab-btn" data-filter="sistemas">
      <span>⚙️ Sistemas & Redes</span>
      <span class="mini-badge mono">[2]</span>
    </button>
  </div>

  <!-- GRILLA DE TARJETAS -->
  <div class="cards-layout-grid">
    {proyectosMaterias.map(p => (
      <CardProyecto
        tipo="materia"
        titulo={p.titulo}
        materiaOEstado={p.materiaOEstado}
        profesorOCatedra={p.profesorOCatedra}
        fecha={p.fecha}
        descripcion={p.descripcion}
        metrica={p.metrica}
        mockupTag={p.mockupTag}
        previewCode={p.previewCode}
        tags={p.tags}
        caracteristicas={p.caracteristicas}
        linkRepo={p.linkRepo}
        categoriaData={p.categoriaData}
      />
    ))}
  </div>
</Layout>

<script>
  const btns = document.querySelectorAll('.filter-tab-btn');
  const boxes = document.querySelectorAll('.project-box');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      boxes.forEach(box => {
        const cat = box.getAttribute('data-category');
        if (filter === 'todos' || cat === filter) {
          box.style.display = 'flex';
        } else {
          box.style.display = 'none';
        }
      });
    });
  });
</script>
