# ==========================================================
# 🧭 RIQSI RUTAS — Variables de Entorno (Ejemplo)
# Copiar como .env y completar con tus valores reales.
# ==========================================================

# ── Supabase ───────────────────────────────────────────────
# Obtén estos valores en: https://supabase.com/dashboard/project/mgkxnplbcdxfuxdlcyzl → Settings → API
VITE_SUPABASE_URL=https://mgkxnplbcdxfuxdlcyzl.supabase.co
VITE_SUPABASE_ANON_KEY=tu-supabase-anon-key-aqui

# ── Backend Switch ─────────────────────────────────────────
# "supabase" (default) | "firebase"
VITE_BACKEND=supabase

# ── Firebase ───────────────────────────────────────────────
# Obtén estos valores en: https://console.firebase.google.com/project/riqsi-rutas → Configuración del Proyecto → Tus apps → Web (</>)
VITE_FIREBASE_API_KEY=AIzaSyTuClaveDeApiAqui
VITE_FIREBASE_AUTH_DOMAIN=riqsi-rutas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=riqsi-rutas
VITE_FIREBASE_STORAGE_BUCKET=riqsi-rutas.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── Modo de Seguridad ─────────────────────────────────────
# 'memory-only' = Zero-Storage (CERO persistencia en disco o localStorage)
VITE_STORAGE_SECURITY_MODE=memory-only
