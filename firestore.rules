rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfiles de usuario
    match /users/{userId} {
      allow read, write: if true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Tareas / Notas personales
    match /todos/{todoId} {
      allow read, write: if true;
    }

    // Destinos turísticos: lectura y escritura habilitadas para sincronización
    match /places/{placeId} {
      allow read, write: if true;
    }

    // Anuncios y banners oficiales
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Reservas de experiencias turísticas
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
